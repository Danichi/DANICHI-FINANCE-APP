# Copy this file to .env and fill in your values
# These are the environment variables you set in Railway's dashboard

# The URL of your Railway deployment (set automatically by Railway, no action needed)
# PORT=3001

# Set this to "production" on Railway (Railway sets this automatically)
# NODE_ENV=production

# If you ever want to run the frontend separately from the backend,
# set this to your backend's Railway URL (e.g. https://your-app.railway.app)
# VITE_API_URL=
