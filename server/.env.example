# ── Danichi Finance Server — Environment Variables ──────────────────────────

# Port the API server listens on (Railway sets this automatically)
PORT=3001

# Absolute path to the SQLite database file
# On Railway, use a persistent volume mount path
DB_PATH=./danichi.db

# Comma-separated list of allowed CORS origins
# Add your Cloudflare Pages URL here for production
CORS_ORIGINS=http://localhost:5173,http://localhost:4173,https://your-app.pages.dev

# Node environment
NODE_ENV=development
